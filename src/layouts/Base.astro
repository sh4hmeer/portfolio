    <script is:inline>
      (function () {
        // entrance fades (short, one-shot)
        const rv = document.querySelectorAll('.rv');
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver((es) => es.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          }), { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
          rv.forEach((el) => io.observe(el));
        } else { rv.forEach((el) => el.classList.add('in')); }

        // scroll spy for the top bar + thin page progress line
        const links = new Map([...document.querySelectorAll('[data-nav]')].map((a) => [a.dataset.nav, a]));
        const prog = document.getElementById('pageProgress');
        const ids = [...links.keys()];
        let ticking = false;
        function update() {
          ticking = false;
          const vh = innerHeight;
          if (prog) {
            const max = document.documentElement.scrollHeight - vh;
            prog.style.width = (max > 0 ? Math.min(1, Math.max(0, scrollY / max)) * 100 : 0).toFixed(2) + '%';
          }
          let current = null;
          for (const id of ids) {
            const el = document.getElementById(id);
            if (!el) continue;
            if (el.getBoundingClientRect().top <= vh * 0.4) current = id;
          }
          links.forEach((a, id) => a.classList.toggle('on', id === current));
        }
        addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
        addEventListener('resize', update, { passive: true });
        update();

        // margin art drifts up slowly as the page scrolls (tile is 900px, so it loops without a seam)
        const art = [...document.querySelectorAll('[data-ma]')];
        if (art.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          let t2 = false;
          const drift = () => { t2 = false; const y = -Math.min(1800, scrollY * 0.18); art.forEach((a) => { a.style.transform = 'translateY(' + y.toFixed(1) + 'px)'; }); };
          addEventListener('scroll', () => { if (!t2) { t2 = true; requestAnimationFrame(drift); } }, { passive: true });
          drift();
        }
      })();
    </script>

    <style>
      .skip { position: absolute; left: 12px; top: -60px; background: var(--ink); color: #fff; padding: 10px 14px; border-radius: 8px; z-index: 100; }
      .skip:focus { top: 12px; }

      .topbar {
        position: sticky; top: 0; z-index: 50; height: var(--bar-h);
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--line);
      }
      .topbar-in { height: 100%; display: flex; align-items: center; gap: 22px; }
      .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; font-weight: 700; font-family: var(--display); font-size: 18px; letter-spacing: -.01em; white-space: nowrap; }
      .brand-mark { width: 14px; height: 14px; border-radius: 4px; background: var(--accent); flex: none; }
      .topnav { display: none; gap: 4px; margin-left: 6px; }
      .topnav a { color: var(--ink-dim); text-decoration: none; font-size: 16px; padding: 8px 10px; border-radius: 8px; white-space: nowrap; }
      .topnav a:hover { color: var(--ink); background: var(--bg-2); }
      .topnav a.on { color: var(--ink); font-weight: 600; }
      .topcta { margin-left: auto; white-space: nowrap; }
      @media (max-width: 480px) { .topcta { font-size: 15px; padding: 6px 12px; min-height: 40px; } .brand { font-size: 17px; } .topbar-in { gap: 12px; } }
      @media (min-width: 1000px) { .topnav { display: flex; } }
      .topbar-progress { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: transparent; }
      .topbar-progress i { display: block; height: 100%; width: 0; background: var(--accent); transition: width .1s linear; }
      main { position: relative; z-index: 1; }
      footer { position: relative; z-index: 1; }
      /* margin art: light sketch lines in the empty side gutters, drifting with the scroll, fading toward
         the content. Only when there is side space to use (1280 px and up); never on tablets or phones. */
      .margin-art { display: none; }
      @media (min-width: 1366px) {
        .margin-art { display: block; }
        .ma { position: fixed; top: -1800px; width: 260px; height: 4600px; max-width: none; z-index: 0; pointer-events: none; will-change: transform; }
        .ma-l { right: calc(50% + 500px); }
        .ma-r { left: calc(50% + 500px); }
      }
    </style>
