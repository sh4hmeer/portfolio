---
import '@fontsource-variable/space-grotesk';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import '../styles/visuals.css';
// Shahmeer's leaf-trail tile (public/leaf-trail.svg) inlined at build time: shapes -> <defs>,
// layout -> a 1440x3000 <pattern>. Inline on purpose: CSS background images did not render for him.
import leafRaw from '../../public/leaf-trail.svg?raw';
const leafInner = leafRaw.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '').replace(/<!--[\s\S]*?-->/g, '');
const leafDefs = (leafInner.match(/<defs>([\s\S]*?)<\/defs>/) || ['', ''])[1];
const leafBody = leafInner.replace(/<defs>[\s\S]*?<\/defs>/, '');

const {
  title = 'Shahmeer Shahid · Software that makes your workflow efficient',
  description = 'Shahmeer Shahid builds software in Ontario that takes messy workflows and makes them efficient: self check-in, live screens for every role, test results straight into the chart, and more. Running today in healthcare.',
} = Astro.props;

// Top-bar links. Short, plain words. Kept in sync with the section ids in index.astro.
const nav = [
  { id: 'day',      label: 'My work' },
  { id: 'numbers',  label: 'Your numbers' },
  { id: 'how',      label: 'How I work' },
  { id: 'questions',label: 'Good to know' },
  { id: 'contact',  label: 'Get in touch' },
];
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://shahmeershahid.com/" />
    <title>{title}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><rect width='16' height='16' rx='3' fill='%231d7a4b'/><rect x='4' y='4' width='8' height='8' rx='1.5' fill='%23ffffff'/></svg>" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="topbar" aria-label="site">
      <div class="wrap topbar-in">
        <a class="brand" href="#top">
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-name">Shahmeer Shahid</span>
        </a>
        <nav class="topnav" aria-label="sections">
          {nav.map((n) => <a href={`#${n.id}`} data-nav={n.id}>{n.label}</a>)}
        </nav>
        <a class="btn primary small topcta" href="#contact">Get in touch</a>
      </div>
      <span class="topbar-progress" aria-hidden="true"><i id="pageProgress"></i></span>
    </header>

    <!-- leaf trail: Shahmeer's margin art (public/leaf-trail.svg, one 1440x3000 tile that runs down
         the left margin, crosses behind the content, runs down the right, and crosses back). Fixed
         layer drifting at 0.35x scroll speed; hidden under 900px. -->
    <div class="leaf-trail" aria-hidden="true">
      <svg class="lt" data-lt>
        <defs>
          <Fragment set:html={leafDefs} />
          <pattern id="lt-tile" width="1440" height="3000" patternUnits="userSpaceOnUse" data-lt-pattern>
            <Fragment set:html={leafBody} />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#lt-tile)" />
      </svg>
    </div>

    <main id="main">
      <slot />
    </main>

    <footer>
      <div class="wrap">
        <span><b>Shahmeer Shahid</b> · Kitchener, Ontario</span>
        <a href="mailto:shahmeer_shahid@outlook.com">Email</a>
        <a href="https://www.linkedin.com/in/shahmeer-shahid-" target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </footer>

    <script is:inline>
      (function () {
        // entrance fades (short, one-shot)
        const rv = document.querySelectorAll('.rv');
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver((es) => es.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          }), { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
          rv.forEach((el) => io.observe(el));
        } else { rv.forEach((el) => el.classList.add('in')); }

        // scroll spy for the top bar + thin page progress line
        const links = new Map([...document.querySelectorAll('[data-nav]')].map((a) => [a.dataset.nav, a]));
        const prog = document.getElementById('pageProgress');
        const ids = [...links.keys()];
        let ticking = false;
        function update() {
          ticking = false;
          const vh = innerHeight;
          if (prog) {
            const max = document.documentElement.scrollHeight - vh;
            prog.style.width = (max > 0 ? Math.min(1, Math.max(0, scrollY / max)) * 100 : 0).toFixed(2) + '%';
          }
          let current = null;
          for (const id of ids) {
            const el = document.getElementById(id);
            if (!el) continue;
            if (el.getBoundingClientRect().top <= vh * 0.4) current = id;
          }
          links.forEach((a, id) => a.classList.toggle('on', id === current));
        }
        addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
        addEventListener('resize', update, { passive: true });
        update();

        // leaf trail: centred at native size up to 1440px, scaled to the viewport above; drifts at
        // 0.35x scroll speed and loops every tile. Transform only, so it stays cheap.
        const lt = document.querySelector('[data-lt]'), ltp = document.querySelector('[data-lt-pattern]');
        if (lt && ltp) {
          const reduceLt = matchMedia('(prefers-reduced-motion: reduce)').matches;
          let sc = 1, tileH = 3000, t2 = false;
          const size = () => {
            sc = Math.max(1, innerWidth / 1440); tileH = 3000 * sc;
            const tx = (innerWidth - 1440 * sc) / 2;
            ltp.setAttribute('patternTransform', 'translate(' + tx.toFixed(1) + ' 0) scale(' + sc.toFixed(4) + ')');
            lt.style.height = (innerHeight + tileH) + 'px';
            drift();
          };
          const drift = () => { t2 = false; const y = reduceLt ? 0 : -((scrollY * 0.35) % tileH); lt.style.transform = 'translateY(' + y.toFixed(1) + 'px)'; };
          addEventListener('scroll', () => { if (!t2) { t2 = true; requestAnimationFrame(drift); } }, { passive: true });
          addEventListener('resize', size, { passive: true });
          size();
        }
      })();
    </script>

    <style>
      .skip { position: absolute; left: 12px; top: -60px; background: var(--ink); color: #fff; padding: 10px 14px; border-radius: 8px; z-index: 100; }
      .skip:focus { top: 12px; }

      .topbar {
        position: sticky; top: 0; z-index: 50; height: var(--bar-h);
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--line);
      }
      .topbar-in { height: 100%; display: flex; align-items: center; gap: 22px; }
      .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; font-weight: 700; font-family: var(--display); font-size: 18px; letter-spacing: -.01em; white-space: nowrap; }
      .brand-mark { width: 14px; height: 14px; border-radius: 4px; background: var(--accent); flex: none; }
      .topnav { display: none; gap: 4px; margin-left: 6px; }
      .topnav a { color: var(--ink-dim); text-decoration: none; font-size: 16px; padding: 8px 10px; border-radius: 8px; white-space: nowrap; }
      .topnav a:hover { color: var(--ink); background: var(--bg-2); }
      .topnav a.on { color: var(--ink); font-weight: 600; }
      .topcta { margin-left: auto; white-space: nowrap; }
      @media (max-width: 480px) { .topcta { font-size: 15px; padding: 6px 12px; min-height: 40px; } .brand { font-size: 17px; } .topbar-in { gap: 12px; } }
      @media (min-width: 1000px) { .topnav { display: flex; } }
      .topbar-progress { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: transparent; }
      .topbar-progress i { display: block; height: 100%; width: 0; background: var(--accent); transition: width .1s linear; }
      main { position: relative; z-index: 1; }
      footer { position: relative; z-index: 1; }
      /* leaf trail (Shahmeer's design): fixed layer behind everything; the inline svg is one tile
         taller than the viewport and slides up as you scroll. Hidden under 900px. */
      .leaf-trail { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
      .leaf-trail .lt { position: absolute; left: 0; top: 0; width: 100%; height: calc(100vh + 3000px); max-width: none; display: block; will-change: transform; }
      @media (max-width: 900px) { .leaf-trail { display: none; } }
    </style>
  </body>
</html>
