---
// A short background strip: the same kind of work before the clinic.
const stops = [
  { yr: '2023 · Aerospace', org: 'Bombardier', what: 'A camera that watched for tools and equipment left inside aircraft, and weekly reporting that used to be compiled by hand.' },
  { yr: '2024 · Manufacturing', org: 'Onward Manufacturing', what: 'A guided assistant that walks a customer to the right product.' },
  { yr: '2025 · Aerospace', org: 'Mitsubishi Heavy Industries', what: 'An intranet for the whole company, and a camera check for faulty parts, after time spent on the floor making them.' },
];
---
<section id="before" class="section" style="padding-top:0">
  <div class="wrap">
    <div class="section-head rv" style="margin-bottom:24px">
      <p class="eyebrow"><span class="dot"></span> Before the clinic</p>
      <h2 style="font-size:clamp(24px,2.6vw,32px)">The same kind of work, on hangar and factory floors.</h2>
    </div>
    <div class="bt rv">
      {stops.map((s) => (
        <div class="card">
          <div class="yr">{s.yr}</div>
          <b>{s.org}</b>
          <p>{s.what}</p>
        </div>
      ))}
    </div>
  </div>
</section>
