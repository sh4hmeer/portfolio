---
// A short background strip. Same instinct before the clinic: find the real
// problem on the floor, build the fix, hand it over.
const stops = [
  { yr: '2023 · Aerospace', org: 'Bombardier', what: 'A camera system that spots tools and goggles left inside an aircraft, plus the weekly reporting nobody wanted to compile by hand.' },
  { yr: '2024 · Manufacturing', org: 'Onward Manufacturing', what: 'A guided assistant that walks a customer to the right product, front to back.' },
  { yr: '2025 · Aerospace', org: 'Mitsubishi Heavy Industries', what: 'A company-wide intranet, and a computer-vision check for faulty parts after time spent riveting them on the floor.' },
];
---
<section id="before" class="section" style="padding-top:0">
  <div class="wrap">
    <div class="section-head rv" style="margin-bottom:24px">
      <p class="eyebrow"><span class="dot"></span> Before the clinic</p>
      <h2 style="font-size:clamp(24px,2.6vw,32px)">The same job on hangar and factory floors.</h2>
    </div>
    <div class="bt rv">
      {stops.map((s) => (
        <div class="card">
          <div class="yr">{s.yr}</div>
          <b>{s.org}</b>
          <p>{s.what}</p>
        </div>
      ))}
    </div>
  </div>
</section>
