---
// Good to know: four direct answers.
const qs = [
  { q: 'Does this replace the software we already use?', a: 'No. It works alongside the systems you already have, and nobody learns a new system.' },
  { q: 'Is our information safe?', a: 'Yes. Everything stays within your organization and is built to PHIPA and HIPAA standards.' },
  { q: 'How soon does something show up?', a: 'The first piece is running within weeks of my first visit. The rest follows at your pace.' },
  { q: 'What does it cost?', a: 'Adjusted to your needs. Reach out and we will discuss them.' },
];
---
<section id="questions" class="section tint">
  <div class="wrap">
    <div class="section-head rv">
      <p class="eyebrow"><span class="dot"></span> Good to know</p>
      <h2>The questions people ask first.</h2>
    </div>
    <div class="fq rv">
      {qs.map((x) => (
        <div class="fq-item">
          <h3>{x.q}</h3>
          <p>{x.a}</p>
        </div>
      ))}
    </div>
  </div>
</section>
