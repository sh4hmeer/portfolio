---
// Good to know: the few reassurances a clinic owner wants before writing.
// Short on purpose, and light on how anything works under the hood.
const qs = [
  { q: 'Does this replace our EMR?', a: 'No. Everything works alongside the EMR you already use, and nobody has to learn a new system.' },
  { q: 'Is patient information safe?', a: 'Yes. Everything stays within your clinic, the same way your EMR does today. I take that as seriously as you do.' },
  { q: 'How soon does something show up?', a: 'The first piece is usually running within a few weeks of my first visit. The rest follows at a pace that suits your team.' },
  { q: 'What does it cost?', a: 'We agree on it up front, before anything is built, once we both know what your clinic needs. Ask, and I will give you a straight answer.' },
];
---
<section id="questions" class="section tint">
  <div class="wrap">
    <div class="section-head rv">
      <p class="eyebrow"><span class="dot"></span> Good to know</p>
      <h2>The things people usually ask first.</h2>
    </div>
    <div class="fq rv">
      {qs.map((x) => (
        <div class="fq-item">
          <h3>{x.q}</h3>
          <p>{x.a}</p>
        </div>
      ))}
    </div>
  </div>
</section>
