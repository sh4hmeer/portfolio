---
// A visible, numbered index under the hero, so nobody has to discover that the
// page continues.
const parts = [
  { id: 'checkin', label: 'Checking in' },
  { id: 'boards',  label: 'A screen for every role' },
  { id: 'devices', label: 'Test results into the chart' },
  { id: 'doctor',  label: "The doctor's room" },
  { id: 'staff',   label: 'Schedules and the time clock' },
  { id: 'map',     label: 'A live map of the clinic' },
  { id: 'nightly', label: 'Looking back on the day' },
];
const more = [
  { id: 'changed',   label: 'What changed' },
  { id: 'how',       label: 'How I work' },
  { id: 'questions', label: 'Good to know' },
  { id: 'contact',   label: 'Get in touch' },
];
---
<nav class="toc" aria-label="on this page">
  <div class="wrap">
    <div class="toc-in rv">
      <div class="toc-head">
        <b>On this page</b>
        <span>A clinic day in seven parts, then a little about how I work and how to reach me.</span>
      </div>
      <ol class="toc-list">
        {parts.map((p) => <li><a href={`#${p.id}`}>{p.label}</a></li>)}
        {more.map((m) => <li class="more"><a href={`#${m.id}`}>{m.label}</a></li>)}
      </ol>
    </div>
  </div>
</nav>
