---
// Before and after, in the staff's own words, and the numbers worth saying.
const rows = [
  { before: 'Someone at the desk re-types a new address from a card while a line forms.', after: 'Patients check themselves in, and the file updates itself.' },
  { before: 'Someone walks down the hall to ask who is next.', after: 'Every screen already shows who is next.' },
  { before: 'A tech copies eight numbers from a printout into the chart.', after: 'The numbers are in the chart before the printout is torn off.' },
  { before: 'The doctor looks the patient up in three different programs.', after: 'One tap, and all three are open on the right patient.' },
  { before: 'A paper station sheet, a punch clock, and hours added up by hand.', after: 'One screen in the staff room, and timesheets that arrive ready.' },
  { before: 'At the end of the day, nobody can say where it slowed down.', after: 'A note each morning says where, and what to change.' },
];
const numbers = [
  { big: '200x', small: 'faster', text: 'Test results reach the chart in half a second instead of two minutes of typing.', how: 'Measured at the clinic.' },
  { big: '1', small: 'tap', text: 'That is all a patient does to check in. The front desk does nothing.', how: 'Live at the front desk since September 2026.' },
  { big: 'Seconds', small: 'not half a minute', text: "For the doctor's chart, scans and photos to open together on the right patient.", how: 'Timed in the exam rooms.' },
  { big: '400', small: 'patients a day', text: 'Moving through the clinic with every step recorded, and nobody typing any of it.', how: 'Recorded every day since 2026.' },
];
---
<section id="changed" class="section tint">
  <div class="wrap">
    <div class="section-head rv">
      <p class="eyebrow"><span class="dot"></span> What changed</p>
      <h2>Before and after.</h2>
      <p class="lead">Nothing replaced the clinic's EMR and nobody learned a new system. Each piece removed one recurring chore for good.</p>
    </div>

    <div class="ba rv">
      {rows.map((r) => (
        <div class="ba-row">
          <div class="ba-cell before"><span class="tag">Before</span><span>{r.before}</span></div>
          <div class="ba-cell after"><span class="tag">After</span><span>{r.after}</span></div>
        </div>
      ))}
    </div>

    <div class="nm rv">
      {numbers.map((n) => (
        <div class="nm-item">
          <div class="big">{n.big} <small>{n.small}</small></div>
          <p>{n.text}</p>
          <div class="how">{n.how}</div>
        </div>
      ))}
    </div>
  </div>
</section>
