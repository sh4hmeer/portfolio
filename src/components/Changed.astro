---
// What changed, in the staff's own words, and the few numbers worth saying.
const rows = [
  { before: 'Someone at the desk re-types a new address from a card while a line forms.', after: 'Patients check themselves in, and the chart tidies itself.' },
  { before: 'Someone walks down the hall to ask who is next.', after: 'Every screen already shows who is next.' },
  { before: 'A tech copies eight numbers from a printout into the chart.', after: 'The numbers are in the chart before the printout is torn off.' },
  { before: 'The doctor looks the patient up in three different programs.', after: 'One tap, and all three are open on the right patient.' },
  { before: 'A paper station sheet, a punch clock, and hours added up by hand.', after: 'A screen in the staff room with the time clock built in, and timesheets that arrive ready.' },
  { before: 'At the end of the day, nobody can quite say where it slowed down.', after: 'A short note each morning says where, and what to try.' },
];
const numbers = [
  { big: '200x', small: 'faster', text: 'Test results reach the chart in about half a second, instead of a couple of minutes of typing.', how: 'Measured at the clinic, 2026.' },
  { big: '1', small: 'tap', text: 'That is all a patient does to check in. The front desk does nothing.', how: 'In use at the front desk since September 2026.' },
  { big: 'Seconds', small: 'not half a minute', text: "For the doctor's chart, scans and photos to open together on the right patient.", how: 'Timed in the exam rooms, 2026.' },
  { big: 'Every day', small: 'remembered', text: 'The day is recorded as it happens and looked over each night, so the suggestions keep getting better.', how: 'Nobody types any of it.' },
];
---
<section id="changed" class="section tint">
  <div class="wrap">
    <div class="section-head rv">
      <p class="eyebrow"><span class="dot"></span> What changed</p>
      <h2>What it felt like before, and what it feels like now.</h2>
      <p class="lead">None of this replaced the clinic's EMR or asked anyone to learn a new system. Each piece quietly took one recurring chore off a real person.</p>
    </div>

    <div class="ba rv">
      {rows.map((r) => (
        <div class="ba-row">
          <div class="ba-cell before"><span class="tag">Before</span><span>{r.before}</span></div>
          <div class="ba-cell after"><span class="tag">After</span><span>{r.after}</span></div>
        </div>
      ))}
    </div>

    <div class="nm rv">
      {numbers.map((n) => (
        <div class="nm-item">
          <div class="big">{n.big} <small>{n.small}</small></div>
          <p>{n.text}</p>
          <div class="how">{n.how}</div>
        </div>
      ))}
    </div>
  </div>
</section>
