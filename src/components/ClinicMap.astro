---
// The playable clinic map (the pixel-art walkthrough from prototype/, mirrored
// into public/clinic/ by scripts/sync-clinic.mjs). Loads only on request: a big
// Play button swaps in the iframe. On narrow screens it opens in a new tab,
// because the game is built for a wide screen.
import { withBase } from '../lib/url.js';
const src = withBase('clinic/clinic2d.html');
---
<div class="screen gm-wrap" data-game data-src={src} aria-label="Playable clinic map">
  <div class="screen-bar">
    <span class="sdots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="stitle">Clinic map · walk one visit, watch the boards update</span>
    <a class="live" href={src} target="_blank" rel="noopener" style="color:var(--s-text);text-decoration:none">open full screen ↗</a>
  </div>
  <div class="gm">
    <div class="gm-poster" data-poster>
      <div class="gm-tiles" aria-hidden="true">
        <div class="gm-room" data-l="WAITING" style="left:6%;top:14%;width:26%;height:30%"></div>
        <div class="gm-room" data-l="HVF" style="left:36%;top:14%;width:14%;height:22%"></div>
        <div class="gm-room" data-l="VISION" style="left:54%;top:14%;width:16%;height:22%"></div>
        <div class="gm-room" data-l="OCT" style="left:74%;top:14%;width:20%;height:30%"></div>
        <div class="gm-room" data-l="DESK" style="left:6%;top:56%;width:20%;height:28%"></div>
        <div class="gm-room" data-l="EXAM 1" style="left:36%;top:52%;width:16%;height:32%"></div>
        <div class="gm-room" data-l="EXAM 2" style="left:56%;top:52%;width:16%;height:32%"></div>
        <div class="gm-room" data-l="EXAM 3" style="left:76%;top:52%;width:18%;height:32%"></div>
        <span class="gm-dot" style="left:14%;top:30%;background:#5fc88f"></span>
        <span class="gm-dot" style="left:42%;top:26%;background:#ec8b3c"></span>
        <span class="gm-dot" style="left:80%;top:30%;background:#f5c542"></span>
        <span class="gm-dot" style="left:62%;top:70%;background:#b18cf2"></span>
        <span class="gm-dot" style="left:20%;top:70%;background:#5aa7ff"></span>
      </div>
      <div class="gm-launch">
        <button class="btn primary" type="button" data-play>▶ Play the walkthrough</button>
        <small>Loads about 1 MB of pixel art and runs in your browser. Walk with the arrow keys, or let it walk itself.</small>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const root = document.querySelector('[data-game]');
    if (!root) return;
    const btn = root.querySelector('[data-play]');
    btn.addEventListener('click', () => {
      if (!matchMedia('(min-width: 760px)').matches) { window.open(root.dataset.src, '_blank', 'noopener'); return; }
      const f = document.createElement('iframe');
      f.src = root.dataset.src; f.title = 'Clinic patient-flow walkthrough'; f.loading = 'eager';
      f.setAttribute('allow', 'fullscreen');
      const gm = root.querySelector('.gm');
      root.querySelector('[data-poster]').remove();
      gm.appendChild(f);
    });
  })();
</script>
