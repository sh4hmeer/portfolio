---
// Get in touch. Two plain buttons and a short form. The site is static, so the
// form composes an email in the visitor's own mail app: nothing is stored here.
const email = 'shahmeer_shahid@outlook.com';
const seeIt = `mailto:${email}?subject=${encodeURIComponent('A short call to see it running')}&body=${encodeURIComponent('Hi Shahmeer,\n\nI would like to see how it runs. A few times that work for me:\n\n\nClinic:\nEMR:\n')}`;
const ask2027 = `mailto:${email}?subject=${encodeURIComponent('About 2027')}`;
---
<section id="contact" class="section">
  <div class="wrap cf">
    <div class="rv">
      <p class="eyebrow"><span class="dot"></span> Get in touch</p>
      <h2>Happy to show you how it runs.</h2>
      <p class="lead">The easiest way to understand it is to see it. A short video call while the clinic is open, my screen shared on the live boards, and whatever questions you have.</p>
      <div class="cf-ctas">
        <a class="btn primary" href={seeIt}>Set up a short call</a>
        <a class="btn ghost" href={ask2027}>Ask about 2027</a>
      </div>
      <p class="cf-note">I read and reply to every message myself.</p>
      <div class="cf-links">
        <a href={`mailto:${email}`}>{email}</a>
        <a href="https://www.linkedin.com/in/shahmeer-shahid-" target="_blank" rel="noopener">LinkedIn</a>
        <a href="https://github.com/sh4hmeer" target="_blank" rel="noopener">GitHub</a>
      </div>
    </div>

    <form class="cf-form rv" data-fit action={`mailto:${email}`} method="get">
      <div>
        <h3>Or tell me a little about your clinic</h3>
        <p class="hint">A few quick answers. Pressing Send opens the message in your own mail app so you can look it over first.</p>
      </div>
      <div class="cf-row">
        <div class="cf-field"><label for="cf-name">Your name</label><input id="cf-name" name="name" type="text" autocomplete="name" /></div>
        <div class="cf-field"><label for="cf-clinic">Clinic</label><input id="cf-clinic" name="clinic" type="text" autocomplete="organization" /></div>
      </div>
      <div class="cf-row">
        <div class="cf-field">
          <label for="cf-emr">EMR you use</label>
          <select id="cf-emr" name="emr">
            <option>OSCAR</option><option>Accuro</option><option>TELUS PS Suite</option><option>TELUS Med Access</option><option>Another one</option><option>Not sure</option>
          </select>
        </div>
        <div class="cf-field">
          <label for="cf-vol">Patients on a typical day</label>
          <select id="cf-vol" name="volume">
            <option>Under 40</option><option>40 to 80</option><option>80 to 150</option><option>More than 150</option>
          </select>
        </div>
      </div>
      <div class="cf-field">
        <label for="cf-pain">What slows your day down most?</label>
        <textarea id="cf-pain" name="pain" placeholder="A sentence or two is plenty."></textarea>
      </div>
      <div class="cf-send">
        <button class="btn primary" type="submit">Send</button>
        <small>Goes to {email}. Nothing is stored on this site.</small>
      </div>
    </form>
  </div>
</section>

<script is:inline define:vars={{ email }}>
  (function () {
    const f = document.querySelector('[data-fit]');
    if (!f) return;
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const v = (n) => (f.elements[n] && f.elements[n].value || '').trim();
      const body = [
        'Hi Shahmeer,', '',
        'Name: ' + v('name'),
        'Clinic: ' + v('clinic'),
        'EMR: ' + v('emr'),
        'Patients on a typical day: ' + v('volume'), '',
        'What slows the day down most:', v('pain'), '',
      ].join('\n');
      location.href = 'mailto:' + email + '?subject=' + encodeURIComponent('About my clinic' + (v('clinic') ? ': ' + v('clinic') : '')) + '&body=' + encodeURIComponent(body);
    });
  })();
</script>
