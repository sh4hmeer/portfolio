---
// Get in touch. Two buttons and a three-field form that composes an email in
// the visitor's own mail app (the site is static; nothing is stored here).
const email = 'shahmeer_shahid@outlook.com';
const message = `mailto:${email}?subject=${encodeURIComponent('Walk me through the specifics')}`;
const ask2027 = `mailto:${email}?subject=${encodeURIComponent('About 2027')}`;
---
<section id="contact" class="section">
  <div class="wrap cf">
    <div class="rv">
      <p class="eyebrow"><span class="dot"></span> Get in touch</p>
      <h2>Need clarity?</h2>
      <p class="lead">Reach out and I will walk you through the specifics.</p>
      <div class="cf-ctas">
        <a class="btn primary" href={message}>Send a message</a>
        <a class="btn ghost" href={ask2027}>Ask about 2027</a>
      </div>
      <div class="cf-links">
        <a href={`mailto:${email}`}>Email</a>
        <a href="https://www.linkedin.com/in/shahmeer-shahid-" target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </div>

    <form class="cf-form rv" data-fit action={`mailto:${email}`} method="get">
      <h3>Tell me about your work</h3>
      <div class="cf-row">
        <div class="cf-field"><label for="cf-name">Your name</label><input id="cf-name" name="name" type="text" autocomplete="name" /></div>
        <div class="cf-field">
          <label for="cf-industry">Industry</label>
          <select id="cf-industry" name="industry">
            <option>Healthcare</option><option>Pharmacy</option><option>Manufacturing</option><option>Professional services</option><option>Retail</option><option>Other</option>
          </select>
        </div>
      </div>
      <div class="cf-field">
        <label for="cf-pain">What slows your day down?</label>
        <textarea id="cf-pain" name="pain"></textarea>
      </div>
      <div class="cf-send">
        <button class="btn primary" type="submit">Send</button>
      </div>
    </form>
  </div>
</section>

<script is:inline define:vars={{ email }}>
  (function () {
    const f = document.querySelector('[data-fit]');
    if (!f) return;
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const v = (n) => (f.elements[n] && f.elements[n].value || '').trim();
      const body = ['Hi Shahmeer,', '', 'Name: ' + v('name'), 'Industry: ' + v('industry'), '', 'What slows my day down:', v('pain'), ''].join('\n');
      location.href = 'mailto:' + email + '?subject=' + encodeURIComponent('About my work' + (v('industry') ? ': ' + v('industry') : '')) + '&body=' + encodeURIComponent(body);
    });
  })();
</script>
