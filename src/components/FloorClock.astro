---
// The staff-room screen: who is at which station this afternoon, the time clock
// built into it, and the summaries that go out on their own. Made-up staff.
const stations = [
  { st: 'Room 1', cls: 'va', who: 'Priya' }, { st: 'Room 2', cls: 'va', who: 'Dana' }, { st: 'Room 3', cls: 'va', who: 'Lee' },
  { st: 'Imaging', cls: 'oct', who: 'Sam' }, { st: 'Testing', cls: 'hvf', who: 'Noor' }, { st: 'Desk A', cls: 'desk', who: 'Theo' },
  { st: 'Desk B', cls: 'desk', who: 'Maya' }, { st: 'Float', cls: 'float', who: 'Jo' },
];
---
<div class="screen fl" data-floor aria-label="Staff-room screen with the time clock, made-up staff">
  <div class="screen-bar">
    <span class="sdots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="stitle">Tri-City Eye Care · Staff room · Tuesday afternoon</span>
    <span class="live">live</span>
  </div>
  <div class="fl-body">
    <div class="fl-col">
      <div class="fl-panel">
        <div class="ph">Who is where this afternoon</div>
        <div class="fl-st">
          {stations.map((s) => <div class="fl-strow"><span class={`st ${s.cls}`}>{s.st}</span><span class="fl-chip">{s.who}</span></div>)}
          <div class="fl-strow home"><span class="st" style="background:#39404d;color:#e6e9ee">Home</span><span class="fl-chip home">Ravi</span><span class="fl-dim">quiet afternoon</span></div>
        </div>
      </div>
    </div>
    <div class="fl-col">
      <div class="fl-panel">
        <div class="ph">Time clock</div>
        <div class="fl-clock"><button type="button" class="in" tabindex="-1">Check in</button><button type="button" class="out" tabindex="-1">Check out</button></div>
        <div class="fl-innow">In now: <b>Priya</b> <b>Dana</b> <b>Lee</b> <b>Sam</b> <b>Noor</b> <b>Theo</b> <b>Maya</b> <b>Jo</b></div>
        <div class="fl-last" data-last><b>✓</b> <span data-last-text>Priya checked in · 7:52</span></div>
      </div>
      <div class="fl-panel">
        <div class="ph">Goes out on its own</div>
        <div class="fl-mail">
          <div><span class="when">Each morning</span><span>Who is in today<small class="to">to the manager</small></span></div>
          <div><span class="when">End of day</span><span>Anyone who forgot to check out<small class="to">to the manager</small></span></div>
          <div><span class="when">Pay period</span><span>The timesheet, totals already done<small class="to">to whoever runs payroll</small></span></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const root = document.querySelector('[data-floor]');
    if (!root) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const last = root.querySelector('[data-last]'), txt = root.querySelector('[data-last-text]');
    const msgs = ['Priya checked in · 7:52', 'Jo moved to Float · 13:00', 'Ravi sent home · 13:10', 'Sam checked out · 16:58', 'Timesheet sent · Sunday 7:00'];
    let i = 0, loop = null, visible = false;
    function show() { last.classList.add('swap'); setTimeout(() => { txt.textContent = msgs[i++ % msgs.length]; last.classList.remove('swap'); }, 300); }
    function start() { if (loop) return; loop = setInterval(show, 5000); }
    function stop() { clearInterval(loop); loop = null; }
    new IntersectionObserver((es) => es.forEach((e) => { visible = e.isIntersecting; if (visible && !document.hidden) start(); else stop(); }), { threshold: 0.3 }).observe(root);
    document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); else if (visible) start(); });
  })();
</script>
