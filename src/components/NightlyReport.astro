---
// The morning note, as a document: how long people waited through the day,
// where it slowed, and what might help tomorrow. Illustrative numbers in the
// shape of the real thing. Bars draw in once; the findings take turns being
// highlighted, slowly.
const hours = ['8', '9', '10', '11', '12', '1', '2', '3', '4'];
const waits = [6, 9, 14, 18, 15, 11, 29, 38, 22];     // minutes waiting for the doctor, average per hour
const W = 560, H = 190, padL = 34, padB = 26, padT = 24;
const max = 40;
const bw = (W - padL - 10) / waits.length;
const peak = waits.indexOf(Math.max(...waits));
---
<div class="rp" data-report aria-label="Morning note, illustrative">
  <div class="rp-head">
    <b>MORNING NOTE</b>
    <span>Wednesday 7 October · looking back on Tuesday</span>
  </div>

  <div class="rp-chart rv">
    <h4>How long people waited for the doctor, by hour</h4>
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Bar chart of average minutes waiting for the doctor per hour; the longest waits were in the early afternoon">
      {[0, 10, 20, 30, 40].map((g) => {
        const y = padT + (H - padT - padB) * (1 - g / max);
        return (<g><line x1={padL} x2={W - 6} y1={y} y2={y} stroke="#e2dfd7" stroke-width="1" /><text x={padL - 8} y={y + 4} text-anchor="end">{g}</text></g>);
      })}
      {waits.map((v, i) => {
        const h = (H - padT - padB) * (v / max);
        const x = padL + i * bw + bw * 0.18;
        const y = H - padB - h;
        return (<g>
          <rect class={`bar ${i === peak ? 'peak' : ''}`} x={x} y={y} width={bw * 0.64} height={h} rx="3" style={`transform-origin: ${x + bw * 0.32}px ${H - padB}px`} />
          <text x={x + bw * 0.32} y={H - 8} text-anchor="middle">{hours[i]}{i < 5 ? 'a' : 'p'}</text>
          {i === peak && <text class="callout" x={x + bw * 0.32} y={y - 8} text-anchor="middle">longest waits, mid-afternoon</text>}
        </g>);
      })}
    </svg>
  </div>

  <h4>Where the day slowed</h4>
  <ul data-findings>
    <li><span><b>Early afternoon:</b> a long run of people waiting for Dr. Rao after a few visits ran over.</span></li>
    <li><span><b>Late morning:</b> an imaging room sat quiet for half an hour while four people were ready for it.</span></li>
    <li><span><b>One patient</b> waited close to an hour because drops went in before a test that needed clear eyes.</span></li>
  </ul>

  <h4>Worth trying tomorrow</h4>
  <ul class="rp-try" data-findings>
    <li><span>Bring two of the early-afternoon imaging visits forward while the rooms are open.</span></li>
    <li><span>Do the field test before the drops for glaucoma visits.</span></li>
  </ul>

  <div class="rp-foot">Nobody typed any of this. It is written from the day's own record.</div>
</div>

<style is:global>
  .rp-chart .bar { transform: scaleY(0); transition: transform .9s cubic-bezier(.2,.7,.2,1); }
  .rp-chart.in .bar { transform: scaleY(1); }
  @media (prefers-reduced-motion: reduce) { .rp-chart .bar { transform: none; transition: none; } }
</style>

<script is:inline>
  (function () {
    const root = document.querySelector('[data-report]');
    if (!root || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const items = [...root.querySelectorAll('[data-findings] li')];
    let i = 0, loop = null, visible = false;
    function next() { items.forEach((li) => li.classList.remove('hl')); items[i % items.length].classList.add('hl'); i++; }
    function start() { if (loop) return; next(); loop = setInterval(next, 4200); }
    function stop() { clearInterval(loop); loop = null; }
    new IntersectionObserver((es) => es.forEach((e) => { visible = e.isIntersecting; if (visible && !document.hidden) start(); else stop(); }), { threshold: 0.25 }).observe(root);
    document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); else if (visible) start(); });
  })();
</script>
