---
// Your numbers: the visitor types how many people come through their door on a
// typical day, and the per-person savings measured at the clinic add up for
// them. Replaces the before/after rows and metric cards, which repeated the
// parts above. Per-person figures (seconds) are the flat savings per visit.
const rates = [
  { key: 'checkin', label: 'Check-in', each: '35 s back at the front desk, per person', sec: 35 },
  { key: 'results', label: 'Results into the chart', each: '1 min 55 s of typing gone, per result', sec: 115 },
  { key: 'doctor',  label: "The doctor's workspace", each: '27 s back, per patient', sec: 27 },
];
const DEFAULT = 120;
---
<section id="numbers" class="section tint">
  <div class="wrap">
    <div class="section-head rv">
      <p class="eyebrow"><span class="dot"></span> Your numbers</p>
      <h2>Put in your own numbers.</h2>
      <p class="lead">Every figure above is per person through the door, measured at the clinic. Change the number and see what it adds up to for you.</p>
    </div>

    <div class="yn rv" data-yn>
      <div class="yn-input">
        <label for="yn-n">People through the door on a typical day</label>
        <input id="yn-n" type="number" inputmode="numeric" min="1" max="5000" step="1" value={DEFAULT} />
        <div class="unit">Patients, clients, customers: whoever your front desk sees.</div>
      </div>
      <div class="yn-out">
        {rates.map((r) => (
          <div class="yn-row" data-rate={r.sec}>
            <div><b>{r.label}</b><small>{r.each}</small></div>
            <span class="v" data-v>0 h</span>
          </div>
        ))}
        <div class="yn-row yn-total">
          <div><b>Back every week</b><small>Five-day week, one result per person.</small></div>
          <span class="v" data-total>0 h</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const root = document.querySelector('[data-yn]');
    if (!root) return;
    const input = root.querySelector('#yn-n');
    const rows = [...root.querySelectorAll('[data-rate]')];
    const total = root.querySelector('[data-total]');
    const fmt = (h) => (h >= 10 ? Math.round(h) : Math.round(h * 10) / 10) + ' h';
    function update() {
      const n = Math.max(0, Math.min(5000, parseInt(input.value, 10) || 0));
      let sum = 0;
      rows.forEach((r) => { const h = n * (+r.dataset.rate) * 5 / 3600; sum += h; r.querySelector('[data-v]').textContent = fmt(h) + ' a week'; });
      total.textContent = fmt(sum);
    }
    input.addEventListener('input', update);
    update();
  })();
</script>
