---
// The imaging tech's screen: who is ready for the doctor, who is in each scan
// room, and who is next in line for a scan (longest wait first). Made-up names.
// Timers tick; every few seconds a scan finishes, that patient becomes ready
// for the doctor, and the next in line takes the room.
---
<div class="screen tb" data-triage aria-label="Imaging screen, with made-up patients">
  <div class="screen-bar">
    <span class="sdots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="stitle">Tri-City Eye Care · Imaging</span>
    <span class="live">live</span>
  </div>
  <div class="tb-body">
    <div class="tb-col">
      <div class="tb-colhead"><i style="background:var(--s-purple)"></i> Ready for the doctor</div>
      <div class="tb-list" data-tb-docs></div>
    </div>
    <div class="tb-col">
      <div class="tb-colhead"><i style="background:var(--s-blue)"></i> Scan rooms</div>
      <div class="tb-list" data-tb-rooms></div>
    </div>
    <div class="tb-col">
      <div class="tb-colhead"><i style="background:var(--s-yellow)"></i> Next for a scan <span class="cnt" data-tb-qn>5</span></div>
      <div class="tb-list" data-tb-queue></div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const root = document.querySelector('[data-triage]');
    if (!root) return;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const docsEl = root.querySelector('[data-tb-docs]');
    const roomsEl = root.querySelector('[data-tb-rooms]');
    const queueEl = root.querySelector('[data-tb-queue]');
    const qnEl = root.querySelector('[data-tb-qn]');
    const pad = (n) => String(n).padStart(2, '0');
    const fmt = (s) => pad(Math.floor(s / 60)) + ':' + pad(s % 60);
    const NAMES = ['M. Okafor', 'E. Moreau', 'N. Petrov', 'G. Oduya', 'B. Haddad', 'C. Ruiz', 'F. Dubois', 'I. Novak', 'W. Tan', 'Y. Abara', 'O. Kaur', 'U. Singh'];
    const REASONS = ['Retina scan', 'Nerve scan', 'After injection', 'Diabetic check', 'Glaucoma work-up', 'Before surgery'];
    const docs = [{ name: 'Dr. Rao', n: 2 }, { name: 'Dr. Chen', n: 1 }, { name: 'Dr. Alvarez', n: 1 }];
    const rooms = [
      { label: 'Room 1', occ: { name: 'M. Okafor', doc: 0, t: 3 * 60 + 40 } },
      { label: 'Room 2', occ: { name: 'E. Moreau', doc: 2, t: 1 * 60 + 15 } },
      { label: 'Room 3', occ: null },
    ];
    let queue = [
      { name: 'N. Petrov', reason: 'Retina scan', doc: 1, t: 11 * 60 + 20 },
      { name: 'G. Oduya', reason: 'Nerve scan', doc: 0, t: 8 * 60 + 2 },
      { name: 'B. Haddad', reason: 'Diabetic check', doc: 2, t: 5 * 60 + 48 },
      { name: 'C. Ruiz', reason: 'After injection', doc: 0, t: 2 * 60 + 10 },
      { name: 'F. Dubois', reason: 'Glaucoma work-up', doc: 1, t: 40 },
    ];
    let ix = 7;
    const nextName = () => NAMES[(ix++) % NAMES.length];
    const pick = (a) => a[Math.floor(Math.random() * a.length)];

    function renderDocs() {
      docsEl.innerHTML = docs.map((d, i) => `<div class="tb-doc"><b>${d.name}</b><span class="badge" data-doc="${i}">${d.n}</span></div>`).join('');
    }
    function renderRooms() {
      roomsEl.innerHTML = rooms.map((r, i) => r.occ
        ? `<div class="tb-room occ" data-room="${i}"><div class="rl">${r.label}</div>
             <div class="tb-slot"><b>${r.occ.name}</b><span class="doc">${docs[r.occ.doc].name}</span><span class="t">${fmt(r.occ.t)}</span><span class="done">Done</span></div></div>`
        : `<div class="tb-room empty" data-room="${i}"><div class="rl">${r.label}</div><div class="slot">room free</div></div>`
      ).join('');
    }
    function renderQueue() {
      const sorted = [...queue].sort((a, b) => b.t - a.t);
      queueEl.innerHTML = sorted.map((q) => `<div class="tb-card" data-id="${q.name}">
          <div class="r1"><span class="n">${q.name}</span><span class="t ${q.t > 15 * 60 ? 'late' : ''}">${fmt(q.t)}</span></div>
          <div class="r2"><span>${q.reason}</span><span class="d">${docs[q.doc].name}</span></div></div>`).join('');
      qnEl.textContent = queue.length;
    }
    renderDocs(); renderRooms(); renderQueue();
    if (reduce) return;

    function event() {
      const occupied = rooms.map((r, i) => r.occ ? i : -1).filter((i) => i >= 0);
      if (!occupied.length) return;
      const ri = pick(occupied), r = rooms[ri];
      const btn = roomsEl.querySelector(`[data-room="${ri}"] .done`);
      if (btn) btn.classList.add('press');
      setTimeout(() => {
        const d = r.occ.doc; docs[d].n += 1; r.occ = null;
        renderRooms();
        const b = docsEl.querySelector(`[data-doc="${d}"]`); if (b) { b.textContent = docs[d].n; b.classList.add('pulse'); setTimeout(() => b.classList.remove('pulse'), 400); }
        const first = [...queue].sort((a, b2) => b2.t - a.t)[0];
        const card = queueEl.querySelector(`[data-id="${first.name}"]`); if (card) card.classList.add('out');
        setTimeout(() => {
          queue = queue.filter((q) => q !== first);
          r.occ = { name: first.name, doc: first.doc, t: 0 };
          queue.push({ name: nextName(), reason: pick(REASONS), doc: Math.floor(Math.random() * 3), t: 0 });
          renderRooms(); renderQueue();
          const n = queueEl.querySelector('.tb-card:last-child'); if (n) n.classList.add('new');
        }, 500);
      }, 450);
    }
    let tick = null, ev = null, visible = false;
    function start() {
      if (tick) return;
      tick = setInterval(() => {
        queue.forEach((q) => q.t += 1); rooms.forEach((r) => { if (r.occ) r.occ.t += 1; });
        queueEl.querySelectorAll('.tb-card').forEach((el) => { const q = queue.find((x) => x.name === el.dataset.id); if (!q) return; const t = el.querySelector('.t'); t.textContent = fmt(q.t); t.classList.toggle('late', q.t > 15 * 60); });
        rooms.forEach((r, i) => { if (!r.occ) return; const t = roomsEl.querySelector(`[data-room="${i}"] .t`); if (t) t.textContent = fmt(r.occ.t); });
      }, 1000);
      ev = setInterval(event, 7000);
    }
    function stop() { clearInterval(tick); clearInterval(ev); tick = ev = null; }
    new IntersectionObserver((es) => es.forEach((e) => { visible = e.isIntersecting; if (visible && !document.hidden) start(); else stop(); }), { threshold: 0.1 }).observe(root);
    document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); else if (visible) start(); });
  })();
</script>
