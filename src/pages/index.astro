---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import DayStop from '../components/DayStop.astro';
import Kiosk from '../components/Kiosk.astro';
import LoungeBoard from '../components/LoungeBoard.astro';
import DeviceRace from '../components/DeviceRace.astro';
import DoctorFlow from '../components/DoctorFlow.astro';
import FloorClock from '../components/FloorClock.astro';
import FloorMap from '../components/FloorMap.astro';
import NightlyReport from '../components/NightlyReport.astro';
import Changed from '../components/Changed.astro';
import HowIWork from '../components/HowIWork.astro';
import Questions from '../components/Questions.astro';
import Contact from '../components/Contact.astro';
---
<Base>
  <Hero />

  <!-- One clinic day in seven parts. Each part: one bold claim with a number, one grey line, one screen. -->
  <div id="day" style="scroll-margin-top: var(--bar-h)">

    <DayStop id="checkin" n={1} time="Early morning · front desk">
      <Fragment slot="claim">
        A patient walks in and checks in at a kiosk. They drop in their health card, and the EMR checks them
        in on its own. At the clinic's 400 patients a day, that frees the staff 4 hours every day.
      </Fragment>
      <Fragment slot="detail">
        Any card, inserted any direction. If the card is new, it is verified and the patient's file is
        updated automatically. No typing, no line at the desk. Foolproof.
      </Fragment>
      <Fragment slot="visual"><Kiosk /></Fragment>
    </DayStop>

    <DayStop id="boards" n={2} time="Mid-morning · every screen in the clinic" wide>
      <Fragment slot="claim">
        Every screen in the clinic shows who is next and how long they have waited. Doctors, techs and the
        front desk all see the same picture, so nobody walks the hall to ask, and nobody is left waiting in a
        room.
      </Fragment>
      <Fragment slot="detail">
        One screen per role, on the TVs the clinic already had. Move a patient along on one screen and
        every other screen follows, with the EMR updated at the same time. Doctors can open theirs on a phone.
      </Fragment>
      <Fragment slot="visual"><LoungeBoard /></Fragment>
    </DayStop>

    <DayStop id="devices" n={3} time="Late morning · imaging room">
      <Fragment slot="claim">
        Test results go straight from the machine into the patient's chart. 200 times faster than typing
        them in, with zero typos. Across the clinic's machines, that is another 2 hours a day back.
      </Fragment>
      <Fragment slot="detail">
        Every machine in the clinic feeds the chart the same way. The tech finishes the test and walks the
        patient to the next room. The numbers are already in the chart, exactly as measured.
      </Fragment>
      <Fragment slot="visual"><DeviceRace /></Fragment>
    </DayStop>

    <DayStop id="doctor" n={4} time="Late morning · exam room" flip>
      <Fragment slot="claim">
        The doctor taps the patient's name once, and the chart, the scans and the photos open across two
        monitors. Half a minute saved on every patient. Across 400 patients, that is over 3 hours of doctor
        time a day.
      </Fragment>
      <Fragment slot="detail">
        Always the right patient, and the right view for that visit: a scan review brings up the scan, a
        glaucoma visit brings up the field test.
      </Fragment>
      <Fragment slot="visual"><DoctorFlow /></Fragment>
    </DayStop>

    <DayStop id="staff" n={5} time="Midday · staff room">
      <Fragment slot="claim">
        The staff schedule and the time clock live on one screen in the staff room. The manager runs the
        floor from the office, and payroll that used to take an afternoon now takes no time at all.
      </Fragment>
      <Fragment slot="detail">
        Staff clock in and out with a personal code. The manager gets a morning and an end-of-day summary,
        and the pay-period timesheet arrives with the totals done.
      </Fragment>
      <Fragment slot="visual"><FloorClock /></Fragment>
    </DayStop>

    <DayStop id="map" n={6} time="Afternoon · anywhere in the clinic" flip>
      <Fragment slot="claim">
        A live map of the clinic. Every patient is a dot moving from the front desk to the exam room,
        colour-coded by stage. Anyone on staff sees the whole clinic in one glance.
      </Fragment>
      <Fragment slot="detail">
        The same colours as the screens. An empty room with people waiting stands out instantly.
      </Fragment>
      <Fragment slot="visual"><FloorMap /></Fragment>
    </DayStop>

    <DayStop id="nightly" n={7} time="After close" last>
      <Fragment slot="claim">
        Every night the day is reviewed, and a short note lands in the manager's inbox: where the day slowed
        down, and what to change tomorrow. The clinic gets faster every week.
      </Fragment>
      <Fragment slot="detail">
        Every step of every visit is recorded automatically, with a time. Nobody types any of it, and the
        staff always make the final call.
      </Fragment>
      <Fragment slot="visual"><NightlyReport /></Fragment>
    </DayStop>
  </div>

  <Changed />
  <HowIWork />
  <Questions />
  <Contact />
</Base>
