---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import DayStop from '../components/DayStop.astro';
import Kiosk from '../components/Kiosk.astro';
import LoungeBoard from '../components/LoungeBoard.astro';
import DeviceRace from '../components/DeviceRace.astro';
import DoctorFlow from '../components/DoctorFlow.astro';
import FloorClock from '../components/FloorClock.astro';
import FloorMap from '../components/FloorMap.astro';
import NightlyReport from '../components/NightlyReport.astro';
import Numbers from '../components/Numbers.astro';
import HowIWork from '../components/HowIWork.astro';
import Questions from '../components/Questions.astro';
import Contact from '../components/Contact.astro';
---
<Base>
  <Hero />

  <!-- One clinic day in seven parts. Each part: one bold sentence or two with a number, one grey
       paragraph of detail, one screen. nextFlip tells the squiggle which side the next numeral is on. -->
  <div id="day" style="scroll-margin-top: var(--bar-h)">

    <DayStop id="checkin" n={1} time="Front desk" nextFlip={false}>
      <Fragment slot="claim">
        Patients check themselves in at a kiosk, and the EMR marks them arrived. That hands the front desk
        35 seconds per person: 3 hours and 40 minutes a day at this clinic.
      </Fragment>
      <Fragment slot="detail">
        Drop in any card, any direction, and it reads the details off it. A health card is verified on the
        spot, and a new one updates the file automatically. No typing, no line at the desk. Foolproof.
      </Fragment>
      <Fragment slot="visual"><Kiosk /></Fragment>
    </DayStop>

    <DayStop id="boards" n={2} time="The TVs on the wall" wide nextFlip={false}>
      <Fragment slot="claim">
        Every TV in the clinic shows who is next and how long they have waited, so nobody walks the hall
        to ask, and nobody is left waiting in a room.
      </Fragment>
      <Fragment slot="detail">
        Doctors, techs and the front desk all see the same picture: one view per role, on the TVs the
        clinic already had. Move a patient along on one and all the others follow, with the EMR updated at
        the same time. Open it on any device the clinic wants.
      </Fragment>
      <Fragment slot="visual"><LoungeBoard /></Fragment>
    </DayStop>

    <DayStop id="devices" n={3} time="Imaging room" nextFlip={true}>
      <Fragment slot="claim">
        Test results go straight from the machine into the patient's chart in half a second, instead of
        two minutes of typing. On three machines, that is 1 hour and 50 minutes a day.
      </Fragment>
      <Fragment slot="detail">
        Zero typos, and every machine feeds the chart the same way. The tech finishes the test and walks
        the patient to the next room; the numbers are already in the chart, exactly as measured.
      </Fragment>
      <Fragment slot="visual"><DeviceRace /></Fragment>
    </DayStop>

    <DayStop id="doctor" n={4} time="Exam room" flip nextFlip={false}>
      <Fragment slot="claim">
        The doctor taps a name once, and the chart, the scans and the photos are open before they sit
        down. On average, 27 seconds back per patient: 2 hours and 50 minutes of doctor time a day here.
      </Fragment>
      <Fragment slot="detail">
        One monitor or three, it lays itself out to fit the room. Always the right patient, and the right
        view for that visit: a scan review brings up the scan, a glaucoma visit brings up the field test.
      </Fragment>
      <Fragment slot="visual"><DoctorFlow /></Fragment>
    </DayStop>

    <DayStop id="staff" n={5} time="Staff room" nextFlip={true}>
      <Fragment slot="claim">
        The staff schedule and the time clock live on one screen in the staff room, and payroll that took
        an afternoon every two weeks now takes no time at all.
      </Fragment>
      <Fragment slot="detail">
        The manager runs the floor from the office. Staff clock in and out with a personal code, the
        manager gets a morning and an end-of-day summary, and the pay-period timesheet arrives with the
        totals done.
      </Fragment>
      <Fragment slot="visual"><FloorClock /></Fragment>
    </DayStop>

    <DayStop id="map" n={6} time="Anywhere in the clinic" flip nextFlip={false}>
      <Fragment slot="claim">
        A live map of the clinic: every patient is a dot moving from the front desk to the exam room, so
        anyone on staff sees the whole clinic in one glance.
      </Fragment>
      <Fragment slot="detail">
        Colour-coded by stage, the same colours as the TVs. An empty room with people waiting stands out
        instantly.
      </Fragment>
      <Fragment slot="visual"><FloorMap /></Fragment>
    </DayStop>

    <DayStop id="nightly" n={7} time="The manager's inbox" last>
      <Fragment slot="claim">
        Every night the day is reviewed, and a short note lands in the manager's inbox: where it slowed
        down, and what to change tomorrow.
      </Fragment>
      <Fragment slot="detail">
        One system watching the whole clinic builds a far more detailed record than anyone could keep by
        hand, and the machine-learning model trained on it gets sharper every day: where each staff member
        performs best, which schedule brings in the most, where the bottlenecks form, and metrics you would
        never think to ask for, found daily and handed to you. The clinic gets faster every week, and the
        staff always make the final call.
      </Fragment>
      <Fragment slot="visual"><NightlyReport /></Fragment>
    </DayStop>
  </div>

  <Numbers />
  <HowIWork />
  <Questions />
  <Contact />
</Base>
